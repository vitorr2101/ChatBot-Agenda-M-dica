# Gemini AI Configuration
# Get your API key from https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# MCP Server Configuration
# Set this to the directory containing your MCP server
MCP_SERVER_DIR=../server

# LLM Model Configuration
# Available models: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
DEFAULT_MODEL=gemini-2.0-flash
# Set the temperature for model responses (0.0 to 1.0)
# Lower values make responses more deterministic, higher values make them more random
TEMPERATURE=0.5

# Session Security
# Leave empty to auto-generate, or set your own secure random string
SESSION_SECRET_KEY=

# Application Configuration
DEBUG=True
LOG_LEVEL=DEBUG

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS Configuration
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
