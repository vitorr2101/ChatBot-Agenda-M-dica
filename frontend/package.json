    "framer-motion": "^11.18.2",
    "lucide-react": "^0.525.0",
    "next": "13.5.11",
    "next-themes": "^0.4.6",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-markdown": "^9.1.0",
